{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvaluationHarnessAPI",
  "description": "API Contract for POST /api/v1/run-evals",
  "type": "object",
  "endpoints": {
    "/api/v1/run-evals": {
      "post": {
        "summary": "Execute automated evaluation benchmark test harness",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "run_adversarial": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluation Benchmark Summary Report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "total_tests",
                    "passed_tests",
                    "failed_tests",
                    "average_score",
                    "results"
                  ],
                  "properties": {
                    "total_tests": { "type": "integer", "example": 10 },
                    "passed_tests": { "type": "integer", "example": 10 },
                    "failed_tests": { "type": "integer", "example": 0 },
                    "average_score": { "type": "number", "example": 0.96 },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["test_id", "task_name", "test_type", "passed", "quality_score", "evaluation_notes"],
                        "properties": {
                          "test_id": { "type": "string", "example": "TC-TRIAGE-01" },
                          "task_name": { "type": "string", "example": "Task 1: Triage" },
                          "test_type": { "type": "string", "enum": ["Standard", "Edge", "Adversarial"], "example": "Standard" },
                          "passed": { "type": "boolean", "example": true },
                          "quality_score": { "type": "number", "example": 1.0 },
                          "evaluation_notes": { "type": "string", "example": "Correctly classified P1 outage with exact KB snippet match." }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
